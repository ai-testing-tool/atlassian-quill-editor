{
  "name": "@ai-testing-tool/atlassian-quill-editor",
  "version": "0.1.0",
  "description": "React Quill editor that round-trips Atlassian Document Format (ADF) for Jira descriptions",
  "license": "MIT",
  "type": "module",
  "main": "./dist/atlassian-quill-editor.cjs",
  "module": "./dist/atlassian-quill-editor.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/atlassian-quill-editor.js",
      "require": "./dist/atlassian-quill-editor.cjs"
    },
    "./styles.css": "./dist/atlassian-quill-editor.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "release": "sh scripts/publish.sh",
    "release:dry": "DRY_RUN=true sh scripts/publish.sh"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@ai-testing-tool/atlassian-adf-lite": "^0.1.3",
    "quill": "^2.0.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^3.2.8",
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/addon-interactions": "^8.4.7",
    "@storybook/blocks": "^8.4.7",
    "@storybook/react": "^8.4.7",
    "@storybook/react-vite": "^8.4.7",
    "@storybook/test": "^8.4.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^8.4.7",
    "tailwindcss": "^3.4.17",
    "typescript": "5.4",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/ai-testing-tool/atlassian-quill-editor.git"
  },
  "homepage": "https://github.com/ai-testing-tool/atlassian-quill-editor#readme",
  "bugs": {
    "url": "https://github.com/ai-testing-tool/atlassian-quill-editor/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "atlassian",
    "adf",
    "jira",
    "quill",
    "react",
    "editor"
  ]
}
